---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const capabilities = [
  { index: "01", name: "DNS", command: "cf dns", copy: "Read and change A, AAAA, CNAME, TXT, and MX records with explicit profile context and clean upsert semantics." },
  { index: "02", name: "Workers", command: "cf workers", copy: "List deployments and inspect the persisted logs from the last few minutes without opening the dashboard." },
  { index: "03", name: "Tokens", command: "cf tokens", copy: "Search Cloudflare permissions and mint narrowly scoped credentials for the exact operation an agent needs." },
  { index: "04", name: "R2", command: "cf r2", copy: "Create buckets, mint bucket credentials, and wire Workers trace logs into durable object storage." },
  { index: "05", name: "Profiles", command: "cf profiles", copy: "Keep personal, client, and production accounts unambiguous, with secrets in Keychain instead of config files." },
  { index: "06", name: "Wrangler", command: "cf wrangler", copy: "Snapshot and switch Wrangler accounts instantly instead of logging out and authenticating all over again." }
];

const install = "curl -fsSL https://raw.githubusercontent.com/amxv/cf-cli/main/install.sh | bash";
---

<BaseLayout title={`${siteConfig.name} | Cloudflare operations without the dashboard`} description={siteConfig.description} siteConfig={siteConfig} primaryNav={primaryNav}>
  <main class="landing">
    <section class="hero wrap">
      <div class="eyebrow"><span class="pulse"></span> Agent-first Cloudflare operations</div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Cloudflare,<br/><em>without</em> the<br/>dashboard.</h1>
          <p class="lede">A fast Go CLI for the operational work Wrangler leaves behind: DNS, recent Workers logs, R2, scoped tokens, and painless multi-account switching.</p>
          <div class="actions">
            <a class="button primary" href="/docs/quickstart">Install cf-cli <span>↗</span></a>
            <a class="button secondary" href="https://github.com/amxv/cf-cli">View on GitHub <span>↗</span></a>
          </div>
        </div>
        <div class="terminal-wrap" aria-label="Terminal demonstration">
          <div class="terminal-shadow"></div>
          <div class="terminal">
            <div class="terminal-bar"><span>cf / personal</span><span class="status">● ready</span></div>
            <div class="terminal-body">
              <p><i>$</i> cf --profile personal doctor</p>
              <p class="dim">✓ API token&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;macOS Keychain</p>
              <p class="dim">✓ Account ID&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;resolved</p>
              <p class="dim">✓ Default domain&nbsp;&nbsp;ashray.xyz</p>
              <p class="spacer"><i>$</i> cf dns cname docs cf.pages.dev</p>
              <p class="success">updated CNAME docs → cf.pages.dev</p>
              <p class="spacer"><i>$</i> cf workers logs api --since 10m</p>
              <p class="dim">12:43:08&nbsp; POST /v1/deploy&nbsp; <b>200</b>&nbsp; 84ms</p>
              <p class="cursor"><i>$</i> <span></span></p>
            </div>
          </div>
          <div class="terminal-note">one binary · zero dashboard tabs</div>
        </div>
      </div>
      <div class="ticker" aria-label="Feature summary"><span>DNS</span><b>✦</b><span>WORKERS LOGS</span><b>✦</b><span>R2</span><b>✦</b><span>SCOPED TOKENS</span><b>✦</b><span>MULTI-ACCOUNT</span></div>
    </section>

    <section class="manifesto wrap">
      <p class="kicker">The missing operations layer</p>
      <div class="manifesto-grid">
        <h2>Wrangler deploys.<br/><span>cf operates.</span></h2>
        <div class="manifesto-copy">
          <p>Wrangler is excellent at building and deploying Cloudflare applications. It is not a general interface to the rest of Cloudflare.</p>
          <p><strong>cf-cli fills that gap.</strong> It handles the small operational tasks that otherwise pull you out of your terminal and into a maze of zones, accounts, permissions, and dashboard panels.</p>
        </div>
      </div>
    </section>

    <section class="escape wrap">
      <div class="escape-card">
        <div class="escape-number">∞</div>
        <div class="escape-copy">
          <p class="kicker">The escape hatch</p>
          <h2>The CLI does not need to know every Cloudflare API call.</h2>
          <p>A bootstrap token can mint a new token scoped to exactly the permissions an agent needs. When a first-class command does not exist yet, the agent reads Cloudflare’s API docs, creates a temporary least-privilege credential, and keeps moving.</p>
          <p class="callout">You never become the bottleneck—and the broad master credential never becomes the default.</p>
        </div>
        <div class="token-stack" aria-hidden="true">
          <div class="token token-one"><small>BOOTSTRAP</small><b>••••••••••••</b><span>mint only</span></div>
          <div class="token token-two"><small>SCOPED TOKEN</small><b>Workers Logs: Read</b><span>expires soon</span></div>
        </div>
      </div>
    </section>

    <section class="capabilities wrap">
      <div class="section-head"><div><p class="kicker">Command surface</p><h2>Six sharp tools.<br/>One tiny binary.</h2></div><p>Purpose-built commands for the Cloudflare work agents and engineers actually repeat.</p></div>
      <div class="cap-grid">
        {capabilities.map((item) => (
          <article class="cap-card">
            <div class="cap-top"><span>{item.index}</span><code>{item.command}</code></div>
            <h3>{item.name}</h3>
            <p>{item.copy}</p>
            <a href="/docs/command-reference" aria-label={`Read ${item.name} documentation`}>Read docs <span>↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="workflow wrap">
      <div class="workflow-copy"><p class="kicker">Made for agents</p><h2>Say what you want.<br/>The CLI explains itself.</h2><p>There is no separate agent handbook to maintain. The command tree, flags, and help text are the interface. An agent starts with <code>cf --help</code>, discovers the right operation, and leaves behind an auditable command.</p></div>
      <div class="conversation">
        <div class="bubble human"><span>YOU</span>Point docs.example.com at the new deployment. Use my personal Cloudflare account.</div>
        <div class="line"></div>
        <div class="bubble agent"><span>AGENT</span><code>cf --profile personal dns cname docs project.pages.dev</code><small>✓ CNAME updated and verified</small></div>
      </div>
    </section>

    <section class="install wrap">
      <div><p class="kicker">Install</p><h2>From zero to <code>cf</code><br/>in one command.</h2></div>
      <div class="install-box"><code>{install}</code><button class="copy-button" data-copy={install} type="button">Copy</button></div>
      <div class="install-links"><a href="/docs/quickstart">Quickstart ↗</a><a href="/docs/authentication">Authentication ↗</a><a href="/docs/command-reference">Command reference ↗</a></div>
    </section>
  </main>
  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy);
      const old = button.textContent; button.textContent = 'Copied';
      setTimeout(() => button.textContent = old, 1400);
    }));
  </script>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Instrument+Sans:wght@400;500;600;700&display=swap");

  :global(body) {
    overflow-x: hidden;
    background: #f3f0e7;
    color: #171715;
  }

  :global(:root[data-theme="dark"] body) {
    background: #10100e;
    color: #f7f3e9;
  }

  .landing {
    --orange: #ff5b22;
    --lime: #c8ff3d;
    --bg: #f3f0e7;
    --text: #171715;
    --muted: #55524b;
    --soft: #747067;
    --line: #8b877d;
    --surface: #fffdf7;
    --surface-subtle: #e9e5db;
    --human-bg: #fffdf8;
    --human-text: #1c1b18;
    color: var(--text);
    font-family: "Instrument Sans", "Avenir Next", sans-serif;
  }

  :global(:root[data-theme="dark"]) .landing {
    --bg: #10100e;
    --text: #f7f3e9;
    --muted: #c6c0b5;
    --soft: #a59f94;
    --line: #56534c;
    --surface: #1b1b18;
    --surface-subtle: #252520;
    --human-bg: #f2eee4;
    --human-text: #1c1b18;
  }

  .wrap {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .hero { padding: 92px 0 0; }

  .eyebrow,
  .kicker {
    color: var(--text);
    font-family: "IBM Plex Mono", monospace;
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: 11px;
    font-weight: 600;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--orange) 20%, transparent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 70px;
    align-items: center;
    padding: 56px 0 84px;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0;
    color: var(--text);
    font-family: "Bricolage Grotesque", "Arial Narrow", sans-serif;
    font-size: clamp(66px, 8vw, 120px);
    font-weight: 800;
    line-height: .79;
    letter-spacing: -.07em;
    text-transform: uppercase;
  }

  .hero h1 em {
    color: var(--orange);
    font-style: normal;
  }

  .lede {
    max-width: 590px;
    margin: 42px 0 34px;
    color: var(--muted);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .landing a.button,
  .landing a.button:visited {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 15px 18px;
    border: 1px solid var(--text);
    color: var(--text);
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .landing a.button.primary,
  .landing a.button.primary:visited {
    background: var(--text);
    color: var(--bg);
  }

  .landing a.button.secondary,
  .landing a.button.secondary:visited {
    background: transparent;
    color: var(--text);
  }

  .landing a.button:hover {
    transform: translate(-3px, -3px);
    box-shadow: 4px 4px 0 var(--orange);
  }

  .terminal-wrap { position: relative; }
  .terminal-shadow {
    position: absolute;
    inset: 30px -22px -22px 30px;
    background: var(--orange);
    transform: rotate(3deg);
  }

  .terminal {
    position: relative;
    border: 1px solid #000;
    background: #121212;
    color: #f3efe5;
    box-shadow: 0 24px 70px #0005;
    transform: rotate(-1.5deg);
  }

  .terminal-bar {
    display: flex;
    justify-content: space-between;
    padding: 13px 16px;
    border-bottom: 1px solid #4a4a45;
    color: #ddd8ce;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .status { color: var(--lime); }
  .terminal-body {
    min-height: 330px;
    padding: 25px 22px 30px;
    color: #f5f1e8;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    line-height: 1.8;
  }
  .terminal-body p { margin: 0; color: inherit; }
  .terminal-body i { margin-right: 8px; color: var(--orange); font-style: normal; }
  .terminal-body .dim { color: #aaa69e; }
  .terminal-body .success { color: var(--lime); }
  .terminal-body .spacer { margin-top: 17px; }
  .terminal-body b { color: #fff; }
  .cursor span {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--orange);
    vertical-align: middle;
    animation: blink 1s steps(1) infinite;
  }

  .terminal-note {
    position: absolute;
    right: -25px;
    bottom: -47px;
    padding: 10px 13px;
    background: var(--lime);
    color: #111;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    transform: rotate(3deg);
  }

  .ticker {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    overflow: hidden;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    white-space: nowrap;
  }
  .ticker b { color: var(--orange); }

  .manifesto { padding: 130px 0; }
  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-top: 34px;
  }

  .manifesto h2,
  .section-head h2,
  .workflow h2,
  .install h2,
  .escape h2 {
    margin: 0;
    color: var(--text);
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 750;
    letter-spacing: -.055em;
    line-height: .92;
    text-transform: uppercase;
  }

  .manifesto h2 { font-size: clamp(48px, 6vw, 86px); }
  .manifesto h2 span {
    color: var(--text);
    opacity: .48;
  }

  .manifesto-copy {
    color: var(--muted);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.65;
  }
  .manifesto-copy p:first-child { margin-top: 0; }
  .manifesto-copy strong { color: var(--orange); }

  .escape-card {
    position: relative;
    display: grid;
    grid-template-columns: 130px 1.15fr .85fr;
    gap: 35px;
    overflow: hidden;
    padding: 62px;
    background: #161614;
    color: #f8f4ea;
  }
  .escape-card::before {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(125deg, transparent 55%, #ff5b2218), repeating-linear-gradient(90deg, transparent 0 59px, #ffffff08 60px);
  }
  .escape-card .kicker { color: #f8f4ea; }
  .escape-number {
    position: relative;
    color: var(--orange);
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 130px;
    font-weight: 700;
    line-height: .7;
  }
  .escape-copy { position: relative; }
  .escape h2 {
    margin: 18px 0 28px;
    color: #faf7ef;
    font-size: clamp(38px, 4vw, 62px);
  }
  .escape-copy > p:not(.kicker):not(.callout) {
    color: #d1ccc2;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.65;
  }
  .callout {
    margin-top: 28px;
    padding-left: 18px;
    border-left: 3px solid var(--orange);
    color: #faf7ef;
    font-weight: 700;
    line-height: 1.5;
  }
  .token-stack { position: relative; min-height: 320px; }
  .token {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 260px;
    height: 145px;
    padding: 20px;
    border: 1px solid #77736a;
    box-shadow: 0 18px 35px #0009;
    font-family: "IBM Plex Mono", monospace;
  }
  .token small,
  .token span {
    font-size: 9px;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .token b { font-size: 14px; }
  .token-one {
    top: 16px;
    right: 30px;
    background: #292925;
    color: #f7f3e9;
    transform: rotate(8deg);
  }
  .token-two {
    top: 135px;
    right: 2px;
    background: var(--orange);
    color: #111;
    transform: rotate(-5deg);
  }

  .capabilities { padding: 140px 0; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 54px;
  }
  .section-head h2 {
    margin-top: 18px;
    font-size: clamp(50px, 6vw, 82px);
  }
  .section-head > p {
    max-width: 390px;
    color: var(--muted);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
  }
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .cap-card {
    display: flex;
    flex-direction: column;
    min-height: 330px;
    padding: 25px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    transition: .2s;
  }
  .cap-card:hover {
    background: var(--orange);
    color: #111;
    box-shadow: 5px 5px 0 var(--text);
    transform: translate(-5px, -5px);
  }
  .cap-top {
    display: flex;
    justify-content: space-between;
    color: inherit;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
  }
  .cap-top code {
    padding: 5px 7px;
    background: #111;
    color: #f5f1e8;
  }
  .cap-card h3 {
    margin: 56px 0 15px;
    color: inherit;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 46px;
    font-weight: 750;
    letter-spacing: -.04em;
    text-transform: uppercase;
  }
  .cap-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.55;
  }
  .cap-card a,
  .cap-card a:visited {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    color: inherit;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cap-card:hover p { color: #21160f; }

  .workflow {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 90px;
    align-items: center;
    padding: 50px 0 150px;
  }
  .workflow h2 {
    margin: 20px 0 28px;
    font-size: clamp(46px, 5vw, 76px);
  }
  .workflow-copy > p:last-child {
    color: var(--muted);
    font-weight: 500;
    line-height: 1.65;
  }
  .workflow-copy code {
    padding: 2px 6px;
    background: #222;
    color: #fff;
    font-family: "IBM Plex Mono", monospace;
  }
  .conversation { position: relative; padding: 30px; }
  .bubble {
    position: relative;
    max-width: 82%;
    padding: 24px;
    border: 1px solid var(--line);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }
  .bubble span {
    display: block;
    margin-bottom: 12px;
    color: inherit;
    font: 600 9px/1 "IBM Plex Mono", monospace;
    letter-spacing: .12em;
  }
  .bubble.human {
    margin-left: auto;
    background: var(--human-bg);
    color: var(--human-text);
    border-color: #bcb7ac;
  }
  .bubble.human span { color: #706b62; }
  .bubble.agent {
    margin-top: 55px;
    background: #111;
    color: #f8f4ea;
    border-color: #383833;
  }
  .bubble.agent code {
    display: block;
    overflow-wrap: anywhere;
    color: var(--lime);
    font: 500 12px/1.5 "IBM Plex Mono", monospace;
  }
  .bubble.agent small {
    display: block;
    margin-top: 15px;
    color: #b8b3a9;
  }
  .line {
    position: absolute;
    top: 130px;
    left: 46%;
    width: 2px;
    height: 80px;
    background: var(--orange);
    transform: rotate(35deg);
  }

  .install {
    padding: 95px 0 120px;
    border-top: 1px solid var(--line);
  }
  .install h2 {
    margin: 18px 0 46px;
    font-size: clamp(50px, 6vw, 86px);
  }
  .install h2 code {
    color: var(--orange);
    font-family: inherit;
  }
  .install-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px;
    background: #141412;
    color: #f4f0e7;
  }
  .install-box code {
    overflow: auto;
    color: #f4f0e7;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
  }
  .copy-button {
    padding: 9px 14px;
    border: 1px solid #77736b;
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .copy-button:hover {
    border-color: var(--orange);
    background: var(--orange);
    color: #111;
  }
  .install-links {
    display: flex;
    justify-content: flex-end;
    gap: 28px;
    margin-top: 20px;
  }
  .install-links a,
  .install-links a:visited {
    color: var(--text);
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }

  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 900px) {
    .hero-grid,
    .manifesto-grid,
    .workflow { grid-template-columns: 1fr; }
    .hero-grid { gap: 75px; }
    .terminal-wrap { width: calc(100% - 20px); }
    .manifesto-grid,
    .workflow { gap: 45px; }
    .escape-card { grid-template-columns: 1fr; padding: 38px; }
    .escape-number { font-size: 80px; }
    .token-stack { min-height: 290px; }
    .cap-grid { grid-template-columns: repeat(2, 1fr); }
    .section-head { display: block; }
    .section-head > p { margin-top: 25px; }
    .workflow { padding-bottom: 100px; }
  }

  @media (max-width: 600px) {
    .wrap { width: min(100% - 24px, 1180px); }
    .hero { padding-top: 55px; }
    .hero h1 { font-size: 59px; }
    .hero-grid { padding-top: 40px; }
    .terminal-body { padding: 18px 14px; font-size: 10px; }
    .terminal-note { right: -10px; }
    .ticker { justify-content: flex-start; }
    .manifesto,
    .capabilities { padding: 95px 0; }
    .manifesto h2,
    .section-head h2,
    .workflow h2,
    .install h2 { font-size: 46px; }
    .cap-grid { grid-template-columns: 1fr; }
    .cap-card { min-height: 270px; }
